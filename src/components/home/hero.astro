---
import Button from "../button.astro";
---

<section
  class="relative isolate min-h-[82svh] overflow-hidden"
>
  <!-- Large background typography -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-[15%]
           overflow-hidden select-none"
  >
    <p
      class="translate-x-[-2vw]
             whitespace-nowrap
             text-[clamp(8rem,20vw,20rem)]
             font-semibold leading-none
             tracking-[-0.09em]
             text-neutral-100/80
             dark:text-neutral-900/70"
    >
      SYSTEMS
    </p>
  </div>

  <!-- Decorative technical line -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-7 top-0
           h-full w-px
           bg-neutral-100
           dark:bg-neutral-900
           lg:left-[calc((100%-72rem)/2)]"
  ></div>

  <div
    class="relative mx-auto flex min-h-[82svh]
           max-w-6xl flex-col
           px-7 pt-8 pb-6
           sm:pt-10 sm:pb-8
           lg:px-8 lg:pt-10"
  >
    <!-- MAIN CONTENT -->
    <div
      class="relative grid flex-1 items-center
             gap-10 md:grid-cols-[1.2fr_0.8fr]
             lg:gap-14"
    >
      <!-- HERO COPY -->
      <div class="relative z-20">
        <p
          class="mb-4 text-xs font-medium uppercase
                 tracking-[0.3em]
                 text-neutral-400
                 dark:text-neutral-600"
        >
          Yessine Eleuchi
        </p>

        <h1
          class="max-w-4xl
                 text-[clamp(3.7rem,8vw,7.5rem)]
                 font-semibold leading-[0.84]
                 tracking-[-0.07em]
                 text-neutral-900 dark:text-white"
        >
          I build software

          <span
            class="block text-neutral-400
                   dark:text-neutral-600"
          >
            systems that work.
          </span>
        </h1>

        <p
          class="mt-7 max-w-xl
                 text-base leading-7
                 text-neutral-500
                 dark:text-neutral-400"
        >
          Full-stack engineer focused on product engineering,
          backend systems and applied AI — from interface and
          architecture to data, automation and production.
        </p>

        <!-- CTA -->
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <Button
            text="View selected work"
            link="#selected-work"
          />

          <a
            href="/cv-yessine-eleuchi.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2
                   text-sm font-medium
                   text-neutral-500
                   transition-colors
                   hover:text-neutral-900
                   dark:text-neutral-500
                   dark:hover:text-white"
          >
            View CV

            <span
              class="transition-transform duration-300
                     group-hover:translate-x-0.5
                     group-hover:-translate-y-0.5"
            >
              ↗
            </span>
          </a>
        </div>
      </div>

      <!-- PORTRAIT -->
      <div
        class="relative z-10 mx-auto w-full
               max-w-sm md:max-w-none"
      >
        <!-- Circle -->
        <div
          aria-hidden="true"
          class="absolute left-1/2 top-1/2
                 aspect-square w-[105%]
                 -translate-x-1/2
                 -translate-y-1/2
                 rounded-full
                 border border-neutral-200
                 dark:border-neutral-800"
        ></div>

        <div
          aria-hidden="true"
          class="absolute left-1/2 top-1/2
                 aspect-square w-[82%]
                 -translate-x-1/2
                 -translate-y-1/2
                 rounded-full
                 border border-dashed
                 border-neutral-200
                 dark:border-neutral-800"
        ></div>

        <!-- Availability -->
        <div
          class="absolute right-0 top-[14%] z-20
                 flex items-center gap-2
                 rounded-full
                 border border-neutral-200
                 bg-white/80 px-3 py-2
                 backdrop-blur-md
                 dark:border-neutral-800
                 dark:bg-neutral-950/80"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex
                     h-full w-full
                     animate-ping rounded-full
                     bg-emerald-400 opacity-50"
            ></span>

            <span
              class="relative inline-flex
                     h-2 w-2 rounded-full
                     bg-emerald-500"
            ></span>
          </span>

          <span
            class="text-[9px] font-medium uppercase
                   tracking-[0.18em]
                   text-neutral-500"
          >
            Available
          </span>
        </div>

        <img
          src="/assets/images/mee.webp"
          alt="Yessine Eleuchi — Software Engineer"
          width="790"
          height="1189"
          loading="eager"
          decoding="async"
          class="portrait-mask relative z-10
                 mx-auto block w-full
                 max-h-[600px]
                 object-contain object-bottom"
        />
      </div>
    </div>

    <!-- TRANSITION TO NEXT SECTION -->
    <div
      class="flex items-center justify-between
             border-t border-neutral-200
             pt-4
             dark:border-neutral-800"
    >
      <p
        class="hidden font-mono
               text-[9px] uppercase
               tracking-[0.24em]
               text-neutral-400
               sm:block
               dark:text-neutral-600"
      >
        Product · Systems · Intelligence
      </p>

      <a
        href="#selected-work"
        class="group ml-auto flex items-center gap-3
               text-[9px] font-medium uppercase
               tracking-[0.22em]
               text-neutral-400
               transition-colors
               hover:text-neutral-900
               dark:text-neutral-600
               dark:hover:text-white"
      >
        Selected work

        <span
          class="transition-transform duration-300
                 group-hover:translate-y-1"
        >
          ↓
        </span>
      </a>
    </div>
  </div>

  <!-- subtle visual transition -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute
           inset-x-0 bottom-0 h-12
           bg-gradient-to-b
           from-transparent to-neutral-50/40
           dark:to-neutral-950/20"
  ></div>
</section>

<style>
  .portrait-mask {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 82%,
      transparent 100%
    );

    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 82%,
      transparent 100%
    );
  }
</style>