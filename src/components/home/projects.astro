---
import projects from "../../collections/projects.json";
import Button from "../button.astro";
import Project from "../project.astro";
---

<section
  id="selected-work"
  class="mx-auto max-w-5xl
         scroll-mt-20
         px-7 pt-4 pb-24
         lg:px-0 lg:pt-6 lg:pb-28"
>
  <!-- HEADER -->
  <div class="mb-7">
    <p
      class="mb-2 text-[10px] font-medium uppercase
             tracking-[0.3em]
             text-neutral-400
             dark:text-neutral-600"
    >
      03 / Selected Work
    </p>

    <h2
      class="text-3xl font-semibold
             tracking-[-0.04em]
             text-neutral-900
             sm:text-4xl
             dark:text-neutral-100"
    >
      Featured Projects
    </h2>
  </div>

  <!-- PROJECT GRID -->
  <div
    class="grid w-full grid-cols-1
           items-stretch
           gap-x-7 gap-y-9
           sm:grid-cols-2"
  >
    {
      projects.slice(0, 4).map((project) => (
        <Project
          name={project.name}
          description={project.description}
          image={project.image}
          slug={project.slug}
          category={project.category}
        />
      ))
    }
  </div>

  <!-- CTA -->
  <div class="mt-10 flex w-full justify-center">
    <Button
      text="View All Projects"
      link="/projects"
    />
  </div>
</section>