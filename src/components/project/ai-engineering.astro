---
interface PipelineStep {
  step: string;
  description: string;
}

interface PromptFamily {
  name: string;
  purpose: string;
  output: string;
}

interface PromptEngineering {
  strategy: string;
  families?: PromptFamily[];
  controls?: string[];
}

interface Rag {
  purpose: string;
  vectorDatabase: string;
  knowledgeSource?: string;
  indexedContext?: string[];
  storedMetadata?: string[];
  retrievalStrategy?: string;
  topK: number;
  similarityThreshold: number;
  designDecisions?: string[];
}

interface Guardrail {
  risk: string;
  control: string;
  behavior: string;
}

interface HumanStage {
  stage: string;
  description: string;
}

interface HumanInTheLoop {
  description: string;
  stages?: HumanStage[];
}

interface Observability {
  tool: string;
  integration?: string;
  tracked?: string[];
  purpose: string;
}

interface Evaluation {
  status: string;
  currentlyObservable?: string[];
  recommendedOfflineMetrics?: string[];
}

interface AIEngineering {
  summary: string;

  pipeline?: PipelineStep[];

  promptEngineering?: PromptEngineering;

  rag?: Rag;

  guardrails?: Guardrail[];

  humanInTheLoop?: HumanInTheLoop;

  observability?: Observability;

  evaluation?: Evaluation;

  reliability?: string[];

  privacyAndCost?: string[];

}

interface Props {
  ai: AIEngineering;
  projectName: string;
  pipelineImage?: string;
}

const {
  ai,
  projectName,
  pipelineImage
}: Props = Astro.props;
---

<section class="mb-16">
  <!-- HEADER -->
  <div class="mb-8">
    <p
      class="mb-2 text-xs font-semibold uppercase tracking-[0.18em]
             text-neutral-400"
    >
      Applied AI
    </p>

    <h2
      class="mb-4 text-2xl font-semibold
             text-neutral-900 dark:text-white"
    >
      AI Engineering
    </h2>

    <p
      class="leading-7 text-neutral-600 dark:text-neutral-400"
    >
      {ai.summary}
    </p>
  </div>

  <!-- OPTIONAL PIPELINE IMAGE -->
  {
    pipelineImage && (
      <figure class="mb-12">
        <div
          class="overflow-hidden border rounded-2xl
                 border-neutral-200 dark:border-neutral-800"
        >
          <img
            src={pipelineImage}
            alt={`${projectName} AI pipeline`}
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </div>

        <figcaption
          class="mt-3 text-xs leading-relaxed
                 text-neutral-500 dark:text-neutral-500"
        >
          Controlled AI workflow from document preparation to
          human-validated software estimation.
        </figcaption>
      </figure>
    )
  }

  <!-- ========================= -->
  <!-- AI PIPELINE -->
  <!-- ========================= -->

  {
    ai.pipeline.length > 0 && (
      <div class="mb-14">
        <h3
          class="mb-2 text-lg font-semibold
                 text-neutral-900 dark:text-white"
        >
          AI Pipeline
        </h3>

        <p
          class="mb-6 text-sm leading-6
                 text-neutral-500 dark:text-neutral-400"
        >
          The workflow is decomposed into specialized and independently
          controlled stages instead of relying on a single end-to-end prompt.
        </p>

        <div class="space-y-3">
          {ai.pipeline.map((item, index) => (
            <div
              class="relative flex gap-4 p-4 border rounded-xl
                     border-neutral-200
                     dark:border-neutral-800
                     bg-white dark:bg-neutral-950"
            >
              <div
                class="flex items-center justify-center
                       shrink-0 w-8 h-8 text-xs font-semibold
                       border rounded-full
                       text-neutral-600
                       border-neutral-300
                       dark:text-neutral-300
                       dark:border-neutral-700"
              >
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="min-w-0">
                <p
                  class="mb-1 text-sm font-semibold
                         text-neutral-900 dark:text-neutral-100"
                >
                  {item.step}
                </p>

                <p
                  class="text-sm leading-6
                         text-neutral-600 dark:text-neutral-400"
                >
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <!-- ========================= -->
  <!-- PROMPT ENGINEERING -->
  <!-- ========================= -->

  {
    ai.promptEngineering && (
      <div class="mb-14">
        <h3
          class="mb-2 text-lg font-semibold
                 text-neutral-900 dark:text-white"
        >
          Prompt Engineering
        </h3>

        <p
          class="mb-6 text-sm leading-6
                 text-neutral-500 dark:text-neutral-400"
        >
          {ai.promptEngineering.strategy}
        </p>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            ai.promptEngineering.families?.map((prompt) => (
              <div
                class="p-4 border rounded-xl
                       border-neutral-200 dark:border-neutral-800"
              >
                <p
                  class="mb-2 text-sm font-semibold
                         text-neutral-900 dark:text-neutral-100"
                >
                  {prompt.name}
                </p>

                <p
                  class="mb-3 text-sm leading-6
                         text-neutral-600 dark:text-neutral-400"
                >
                  {prompt.purpose}
                </p>

                <div
                  class="pt-3 border-t
                         border-neutral-100 dark:border-neutral-800"
                >
                  <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
                    Output
                  </p>

                  <p
                    class="text-xs
                           text-neutral-600 dark:text-neutral-400"
                  >
                    {prompt.output}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        {
          ai.promptEngineering.controls?.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-5">
              {ai.promptEngineering.controls.map((control) => (
                <span
                  class="px-2.5 py-1 text-xs border rounded-md
                         border-neutral-200
                         bg-neutral-50
                         text-neutral-600
                         dark:border-neutral-800
                         dark:bg-neutral-900
                         dark:text-neutral-400"
                >
                  {control}
                </span>
              ))}
            </div>
          )
        }
      </div>
    )
  }


  {
    ai.rag && (
      <div class="mb-14">
        <div class="mb-6">
          <h3
            class="mb-2 text-lg font-semibold
                   text-neutral-900 dark:text-white"
          >
            RAG Engineering
          </h3>

          <p
            class="text-sm leading-6
                   text-neutral-500 dark:text-neutral-400"
          >
            {ai.rag.purpose}
          </p>
        </div>

        <!-- IMPORTANT RAG VALUES -->
        <div class="grid grid-cols-2 gap-3 mb-6 sm:grid-cols-4">
          <div
            class="p-4 border rounded-xl
                   border-neutral-200 dark:border-neutral-800"
          >
            <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
              Vector DB
            </p>

            <p
              class="text-sm font-semibold
                     text-neutral-900 dark:text-neutral-100"
            >
              {ai.rag.vectorDatabase}
            </p>
          </div>

          <div
            class="p-4 border rounded-xl
                   border-neutral-200 dark:border-neutral-800"
          >
            <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
              Top K
            </p>

            <p
              class="text-sm font-semibold
                     text-neutral-900 dark:text-neutral-100"
            >
              {ai.rag.topK}
            </p>
          </div>

          <div
            class="p-4 border rounded-xl
                   border-neutral-200 dark:border-neutral-800"
          >
            <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
              Similarity threshold
            </p>

            <p
              class="text-sm font-semibold
                     text-neutral-900 dark:text-neutral-100"
            >
              ≥ {ai.rag.similarityThreshold}
            </p>
          </div>

          <div
            class="p-4 border rounded-xl
                   border-neutral-200 dark:border-neutral-800"
          >
            <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
              Context
            </p>

            <p
              class="text-sm font-semibold
                     text-neutral-900 dark:text-neutral-100"
            >
              Historical cases
            </p>
          </div>
        </div>

        <!-- INDEX / METADATA -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <p
              class="mb-3 text-sm font-medium
                     text-neutral-800 dark:text-neutral-200"
            >
              Embedded context
            </p>

            <ul
              class="space-y-2 text-sm
                     text-neutral-600 dark:text-neutral-400"
            >
              {
                ai.rag.indexedContext?.map((item) => (
                  <li class="flex gap-2">
                    <span class="text-neutral-400">→</span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p
              class="mb-3 text-sm font-medium
                     text-neutral-800 dark:text-neutral-200"
            >
              Stored metadata
            </p>

            <ul
              class="space-y-2 text-sm
                     text-neutral-600 dark:text-neutral-400"
            >
              {
                ai.rag.storedMetadata?.map((item) => (
                  <li class="flex gap-2">
                    <span class="text-neutral-400">→</span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- RAG DECISIONS -->
        {
          ai.rag.designDecisions?.length > 0 && (
            <div
              class="p-5 mt-6 border border-dashed rounded-xl
                     border-neutral-300
                     dark:border-neutral-700"
            >
              <p
                class="mb-4 text-sm font-semibold
                       text-neutral-900 dark:text-neutral-100"
              >
                Key RAG decisions
              </p>

              <ul
                class="space-y-3 text-sm leading-6
                       text-neutral-600 dark:text-neutral-400"
              >
                {ai.rag.designDecisions.map((decision) => (
                  <li class="flex gap-3">
                    <span>✓</span>
                    <span>{decision}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    )
  }

  <!-- ========================= -->
  <!-- HUMAN IN THE LOOP -->
  <!-- ========================= -->

  {
    ai.humanInTheLoop && (
      <div class="mb-14">
        <h3
          class="mb-2 text-lg font-semibold
                 text-neutral-900 dark:text-white"
        >
          Human-in-the-Loop
        </h3>

        <p
          class="mb-6 text-sm leading-6
                 text-neutral-500 dark:text-neutral-400"
        >
          {ai.humanInTheLoop.description}
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            ai.humanInTheLoop.stages?.map((stage, index) => (
              <div
                class="p-5 border rounded-xl
                       border-neutral-200 dark:border-neutral-800"
              >
                <div
                  class="flex items-center justify-center
                         w-8 h-8 mb-4 text-xs font-semibold
                         rounded-full
                         bg-neutral-100 dark:bg-neutral-900
                         text-neutral-600 dark:text-neutral-300"
                >
                  {index + 1}
                </div>

                <p
                  class="mb-2 text-sm font-semibold
                         text-neutral-900 dark:text-neutral-100"
                >
                  {stage.stage}
                </p>

                <p
                  class="text-sm leading-6
                         text-neutral-600 dark:text-neutral-400"
                >
                  {stage.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    )
  }

  <!-- ========================= -->
  <!-- GUARDRAILS -->
  <!-- ========================= -->

  {
    ai.guardrails?.length > 0 && (
      <div class="mb-14">
        <h3
          class="mb-2 text-lg font-semibold
                 text-neutral-900 dark:text-white"
        >
          AI Reliability & Guardrails
        </h3>

        <p
          class="mb-6 text-sm leading-6
                 text-neutral-500 dark:text-neutral-400"
        >
          Model outputs and retrieved context are validated before they
          can influence the business workflow.
        </p>

        <div class="space-y-3">
          {
            ai.guardrails.map((guardrail) => (
              <div
                class="grid grid-cols-1 gap-3 p-4 border rounded-xl
                       sm:grid-cols-[1fr_1fr_1.4fr]
                       border-neutral-200
                       dark:border-neutral-800"
              >
                <div>
                  <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
                    Risk
                  </p>

                  <p
                    class="text-sm font-medium
                           text-neutral-800 dark:text-neutral-200"
                  >
                    {guardrail.risk}
                  </p>
                </div>

                <div>
                  <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
                    Control
                  </p>

                  <p
                    class="text-sm
                           text-neutral-600 dark:text-neutral-400"
                  >
                    {guardrail.control}
                  </p>
                </div>

                <div>
                  <p class="mb-1 text-[11px] uppercase tracking-wide text-neutral-400">
                    Behavior
                  </p>

                  <p
                    class="text-sm
                           text-neutral-600 dark:text-neutral-400"
                  >
                    {guardrail.behavior}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    )
  }

  <!-- ========================= -->
  <!-- OBSERVABILITY -->
  <!-- ========================= -->

  {
    ai.observability && (
      <div class="mb-14">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <div>
            <h3
              class="text-lg font-semibold
                     text-neutral-900 dark:text-white"
            >
              LLM Observability
            </h3>

            <p
              class="mt-1 text-sm
                     text-neutral-500 dark:text-neutral-400"
            >
              Instrumented around the FastAPI orchestration layer.
            </p>
          </div>

          <span
            class="px-3 py-1 text-xs font-medium border rounded-full
                   border-neutral-200
                   text-neutral-600
                   dark:border-neutral-700
                   dark:text-neutral-300"
          >
            {ai.observability.tool}
          </span>
        </div>

        <div class="flex flex-wrap gap-2">
          {
            ai.observability.tracked?.map((item) => (
              <span
                class="px-2.5 py-1 text-xs border rounded-md
                       border-neutral-200
                       bg-neutral-50
                       text-neutral-600
                       dark:border-neutral-800
                       dark:bg-neutral-900
                       dark:text-neutral-400"
              >
                {item}
              </span>
            ))
          }
        </div>

        <p
          class="mt-5 text-sm leading-6
                 text-neutral-600 dark:text-neutral-400"
        >
          {ai.observability.purpose}
        </p>
      </div>
    )
  }

  <!-- ========================= -->
  <!-- EVALUATION -->
  <!-- ========================= -->

  {
    ai.evaluation && (
      <div class="mb-14">
        <div class="flex items-center gap-3 mb-3">
          <h3
            class="text-lg font-semibold
                   text-neutral-900 dark:text-white"
          >
            Evaluation
          </h3>

          <span
            class="px-2.5 py-1 text-[11px] border rounded-full
                   text-neutral-500
                   border-neutral-200
                   dark:border-neutral-700"
          >
            No invented metrics
          </span>
        </div>

        <p
          class="mb-6 text-sm leading-6
                 text-neutral-500 dark:text-neutral-400"
        >
          {ai.evaluation.status}
        </p>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <p
              class="mb-3 text-sm font-semibold
                     text-neutral-800 dark:text-neutral-200"
            >
              Currently observable
            </p>

            <ul
              class="space-y-2 text-sm
                     text-neutral-600 dark:text-neutral-400"
            >
              {
                ai.evaluation.currentlyObservable?.map((metric) => (
                  <li class="flex gap-2">
                    <span>✓</span>
                    <span>{metric}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p
              class="mb-3 text-sm font-semibold
                     text-neutral-800 dark:text-neutral-200"
            >
              Offline benchmark targets
            </p>

            <ul
              class="space-y-2 text-sm
                     text-neutral-600 dark:text-neutral-400"
            >
              {
                ai.evaluation.recommendedOfflineMetrics?.map((metric) => (
                  <li class="flex gap-2">
                    <span class="text-neutral-400">→</span>
                    <span>{metric}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    )
  }
</section>