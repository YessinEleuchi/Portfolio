---
import Button from "../components/button.astro";
import Projects from "../components/home/projects.astro";
import Separator from "../components/home/separator.astro";
import Writings from "../components/home/writings.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="Yessine Eleuchi — Software Engineer | Full-Stack & Applied AI">
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">

      <!-- HERO CONTENT -->
      <div class="relative w-full md:w-1/2">

        <!-- ROLE -->
        <p
          class="mb-3 text-sm font-medium tracking-wide
                 text-neutral-500 dark:text-neutral-400"
        >
          Software Engineer · Full-Stack · Applied AI
        </p>

        <!-- TITLE -->
        <h1
          class="mb-5 text-4xl font-bold leading-tight
                 md:text-4xl lg:text-6xl dark:text-white"
        >
          Hello, I'm Yessine.
        </h1>

        <!-- INTRO -->
        <p
          class="mb-6 text-base leading-relaxed
                 text-neutral-600 dark:text-neutral-400"
        >
          I build
          <span class="font-medium text-neutral-800 dark:text-neutral-200">
            full-stack software from frontend to production
          </span>,
          with a focus on reliable backend systems, asynchronous workflows,
          databases, and AI-powered applications.
        </p>

        <!-- CORE STACK -->
        <div class="mb-7">
          <p
            class="mb-3 text-sm font-semibold
                   text-neutral-800 dark:text-neutral-200"
          >
            Core stack
          </p>

          <div class="flex flex-wrap gap-2">
            {
              [
                "TypeScript",
                "React",
                "Next.js",
                "Node.js",
                "NestJS",
                "Spring Boot",
                "Laravel",
                "FastAPI",
                "PostgreSQL",
                "Redis",
                "RAG / LLM",
                "Docker",
                "CI/CD",
              ].map((technology) => (
                <span
                  class="px-2.5 py-1 text-xs border rounded-md
                         text-neutral-600 border-neutral-200 bg-neutral-50
                         transition-colors
                         hover:border-neutral-400 hover:text-neutral-900
                         dark:text-neutral-400 dark:border-neutral-800
                         dark:bg-neutral-900
                         dark:hover:border-neutral-600
                         dark:hover:text-neutral-200"
                >
                  {technology}
                </span>
              ))
            }
          </div>
        </div>

        <!-- ENGINEERING FOCUS -->
        <ul
          class="mb-8 space-y-2.5 text-sm
                 text-neutral-500 dark:text-neutral-400"
        >

          <li class="flex gap-2.5">
            <span
              class="shrink-0 text-neutral-400 dark:text-neutral-600"
            >
              →
            </span>

            <span>
              <strong
                class="font-medium text-neutral-800 dark:text-neutral-200"
              >
                Product Engineering
              </strong>
              — end-to-end web applications from UI to production
            </span>
          </li>

          <li class="flex gap-2.5">
            <span
              class="shrink-0 text-neutral-400 dark:text-neutral-600"
            >
              →
            </span>

            <span>
              <strong
                class="font-medium text-neutral-800 dark:text-neutral-200"
              >
                Backend & Systems
              </strong>
              — APIs, databases, async processing, architecture, and CI/CD
            </span>
          </li>

          <li class="flex gap-2.5">
            <span
              class="shrink-0 text-neutral-400 dark:text-neutral-600"
            >
              →
            </span>

            <span>
              <strong
                class="font-medium text-neutral-800 dark:text-neutral-200"
              >
                Applied AI
              </strong>
              — RAG, LLM integration, document automation, and computer vision
            </span>
          </li>

        </ul>

        <!-- CTA -->
<div class="flex flex-wrap items-center gap-3">
  <Button
    text="View Projects"
    link="/projects"
  />

  <Button
    text="LinkedIn"
    link="https://www.linkedin.com/in/eleuchi-yessin1/"
  />

  <a
    href="/cv-yessine-eleuchi.pdf"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center
           h-10 px-5
           text-sm font-medium
           transition-all
           border rounded-full
           border-neutral-300
           text-neutral-700
           hover:bg-neutral-100
           hover:border-neutral-400
           dark:border-neutral-700
           dark:text-neutral-300
           dark:hover:bg-neutral-900
           dark:hover:border-neutral-600"
  >
    Download CV
  </a>
</div>
      </div>

      <!-- PROFILE IMAGE -->
      <div
        class="relative justify-end hidden w-full mt-10
               md:flex md:pl-10 md:w-1/2 md:mt-0
               md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">

          <!-- HELLO ICON -->
          <div
            class="absolute bottom-0 z-40 w-16 h-16
                   -translate-x-6 -translate-y-1/2
                   lg:top-auto top-0
                   lg:-translate-y-[330px]
                   rounded-full"
          >
            <span
              class="relative z-20 flex items-center justify-center
                     w-full h-full text-2xl
                     border-8 border-white rounded-full
                     dark:border-neutral-950
                     bg-neutral-100 dark:bg-neutral-900"
            >
              <span
                class="flex items-center justify-center
                       w-full h-full bg-white
                       border border-dashed rounded-full
                       dark:bg-neutral-950
                       border-neutral-300 dark:border-neutral-700"
              >
                👋
              </span>
            </span>
          </div>

          <!-- IMAGE -->
          <div class="relative z-30 px-10">
            <img
              src="/assets/images/mee.png"
              alt="Yessine Eleuchi — Software Engineer"
              loading="eager"
              decoding="async"
              width="790"
              height="1189"
              class="relative z-30 w-full
                     aspect-[790/1189]
                     md:max-w-md mx-auto
                     dark:-translate-y-0.5"
            />
          </div>

          <!-- IMAGE BACKGROUND -->
          <div
            class="absolute bottom-0 right-0 z-20
                   w-full h-full lg:h-[420px]
                   translate-x-0 -translate-y-px
                   border border-dashed rounded-2xl
                   bg-gradient-to-r
                   dark:from-neutral-950
                   dark:via-black
                   dark:to-neutral-950
                   from-white
                   via-neutral-50
                   to-white
                   border-neutral-300
                   dark:border-neutral-700"
          >
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- PROJECTS -->
  <Separator text="Featured Projects" />
  <Projects />

  <!-- WRITINGS -->
  <Separator text="Engineering Notes" />
  <Writings />

</Layout>