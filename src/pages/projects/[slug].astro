---
import projects from "../../collections/projects.json";
import AIEngineering from "../../components/project/ai-engineering.astro";
import ProjectArchitecture from "../../components/project/project-architecture.astro";
import ProjectCards from "../../components/project/project-cards.astro";
import ProjectHero from "../../components/project/project-hero.astro";
import ProjectNavigation from "../../components/project/project-navigation.astro";
import ProjectScrollEffects from "../../components/project/project-scroll-effects.astro";
import ProjectStory from "../../components/project/project-story.astro";
import Layout from "../../layouts/main.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: any };
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];

const navigationItems = [
  { id: "overview", label: "Overview", visible: true },
  { id: "story", label: "Problem & solution", visible: Boolean(project.problem || project.solution) },
  { id: "architecture", label: "Architecture", visible: Boolean(project.architecture) },
  { id: "ai-engineering", label: "AI engineering", visible: Boolean(project.aiEngineering) },
  { id: "challenges", label: "Challenges", visible: Boolean(project.challenges?.length) },
  { id: "decisions", label: "Decisions", visible: Boolean(project.decisions?.length) },
  { id: "results", label: "Results", visible: Boolean(project.results?.length) },
].filter((item) => item.visible);
---

<Layout title={`${project.name} — Yessine Eleuchi`}>
  <div class="project-case-study">
    <ProjectScrollEffects />
    <ProjectNavigation items={navigationItems} />

    <article class="project-case-study__main">
      <ProjectHero project={project} />

      <ProjectStory problem={project.problem} solution={project.solution} />

      <ProjectArchitecture project={project} />

      {
        project.aiEngineering && (
          <section
            id="ai-engineering"
            class="project-ai-section"
            data-project-section="ai-engineering"
            data-reveal="up"
          >
            <AIEngineering
              ai={project.aiEngineering}
              projectName={project.name}
              pipelineImage={project.aiPipelineImage}
            />
          </section>
        )
      }

      <ProjectCards
        id="challenges"
        eyebrow="03 / Engineering pressure"
        title="Technical challenges."
        items={project.challenges || []}
        variant="deck"
      />

      <ProjectCards
        id="decisions"
        eyebrow="04 / Trade-offs"
        title="Key engineering decisions."
        items={project.decisions || []}
        variant="chessboard"
      />

      <ProjectCards
        id="results"
        eyebrow="05 / Outcome"
        title="What the system delivers."
        items={project.results || []}
        variant="results"
      />

      <footer class="project-outro" data-reveal="up">
        <div class="project-outro__links">
          {
            project.demo && (
              <a href={project.demo} target="_blank" rel="noopener noreferrer">
                Live demo <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {
            project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer">
                GitHub <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>

        {
          nextProject && nextProject.slug !== project.slug && (
            <a class="project-next-link" href={`/projects/${nextProject.slug}`}>
              <span>Next project</span>
              <strong>{nextProject.name}</strong>
              <i aria-hidden="true">→</i>
            </a>
          )
        }
      </footer>
    </article>
  </div>
</Layout>
