---
import projects from "../../collections/projects.json";
import Layout from "../../layouts/main.astro";
import AIEngineering from "../../components/project/ai-engineering.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.name} — Yessine Eleuchi`}>
  <article
    class="relative z-20 max-w-3xl mx-auto my-16 px-7 lg:px-0"
  >
    <!-- Back -->
    <a
      href="/projects"
      class="inline-flex items-center mb-10 text-sm
             text-neutral-500 hover:text-neutral-900
             dark:text-neutral-400 dark:hover:text-white"
    >
      ← Back to projects
    </a>

    <!-- HERO -->
    <header class="mb-12">
      {
        project.category && (
          <p
            class="mb-3 text-sm font-medium
                   text-neutral-500 dark:text-neutral-400"
          >
            {project.category}
          </p>
        )
      }

      <h1
        class="mb-5 text-4xl font-bold tracking-tight
               md:text-5xl text-neutral-950 dark:text-white"
      >
        {project.name}
      </h1>

      <p
        class="max-w-2xl text-lg leading-relaxed
               text-neutral-600 dark:text-neutral-400"
      >
        {project.description}
      </p>
    </header>

    <!-- IMAGE -->
    <figure class="mb-14">
  <img
    src={project.image}
    alt={`${project.name} project`}
    class="w-full rounded-2xl border
           border-neutral-200 dark:border-neutral-800"
  />

  {
    project.imageCaption && (
      <figcaption
        class="mt-3 text-xs leading-relaxed
               text-neutral-500 dark:text-neutral-500"
      >
        {project.imageCaption}
      </figcaption>
    )
  }
</figure>

    <!-- META -->
    <div
      class="grid grid-cols-1 gap-6 pb-10 mb-12 border-b
             sm:grid-cols-2 border-neutral-200 dark:border-neutral-800"
    >
      {
        project.role && (
          <div>
            <p
              class="mb-1 text-xs font-semibold uppercase tracking-wider
                     text-neutral-400"
            >
              Role
            </p>

            <p
              class="text-sm text-neutral-700 dark:text-neutral-300"
            >
              {project.role}
            </p>
          </div>
        )
      }

      <div>
        <p
          class="mb-2 text-xs font-semibold uppercase tracking-wider
                 text-neutral-400"
        >
          Technologies
        </p>

        <div class="flex flex-wrap gap-2">
          {
            project.stack?.map((tech) => (
              <span
                class="px-2.5 py-1 text-xs border rounded-md
                       border-neutral-200 bg-neutral-50
                       text-neutral-600
                       dark:border-neutral-800
                       dark:bg-neutral-900
                       dark:text-neutral-400"
              >
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- PROBLEM -->
    {
      project.problem && (
        <section class="mb-12">
          <h2
            class="mb-4 text-2xl font-semibold
                   text-neutral-900 dark:text-white"
          >
            The problem
          </h2>

          <p
            class="leading-7 text-neutral-600 dark:text-neutral-400"
          >
            {project.problem}
          </p>
        </section>
      )
    }

    <!-- SOLUTION -->
    {
      project.solution && (
        <section class="mb-12">
          <h2
            class="mb-4 text-2xl font-semibold
                   text-neutral-900 dark:text-white"
          >
            The solution
          </h2>

          <p
            class="leading-7 text-neutral-600 dark:text-neutral-400"
          >
            {project.solution}
          </p>
        </section>
      )
    }

    <!-- ARCHITECTURE -->
   {
  project.architecture && (
    <section class="mb-14">
      <h2
        class="mb-4 text-2xl font-semibold
               text-neutral-900 dark:text-white"
      >
        System Architecture
      </h2>

      <p
        class="leading-7 text-neutral-600 dark:text-neutral-400"
      >
        {project.architecture}
      </p>

      {
        project.architectureImage && (
          <figure class="mt-7">
            <div
              class="overflow-hidden border rounded-2xl
                     border-neutral-200 dark:border-neutral-800"
            >
              <img
                src={project.architectureImage}
                alt={`${project.name} system architecture`}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </div>

            <figcaption
              class="mt-3 text-xs leading-relaxed
                     text-neutral-500 dark:text-neutral-500"
            >
              System architecture illustrating the main services,
              infrastructure components, and communication flows.
            </figcaption>
          </figure>
        )
      }
    </section>
  )
}

<!-- AI ENGINEERING -->
{
  project.aiEngineering && (
    <AIEngineering
      ai={project.aiEngineering}
      projectName={project.name}
      pipelineImage={project.aiPipelineImage}
    />
  )
}

    <!-- CHALLENGES -->
    {
      project.challenges?.length > 0 && (
        <section class="mb-12">
          <h2
            class="mb-5 text-2xl font-semibold
                   text-neutral-900 dark:text-white"
          >
            Technical challenges
          </h2>

          <ul
            class="space-y-3 text-neutral-600 dark:text-neutral-400"
          >
            {project.challenges.map((challenge) => (
              <li class="flex gap-3">
                <span class="text-neutral-400">→</span>
                <span>{challenge}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- DECISIONS -->
    {
      project.decisions?.length > 0 && (
        <section class="mb-12">
          <h2
            class="mb-5 text-2xl font-semibold
                   text-neutral-900 dark:text-white"
          >
            Key engineering decisions
          </h2>

          <ul
            class="space-y-3 text-neutral-600 dark:text-neutral-400"
          >
            {project.decisions.map((decision) => (
              <li class="flex gap-3">
                <span class="text-neutral-400">→</span>
                <span>{decision}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- RESULTS -->
    {
      project.results?.length > 0 && (
        <section class="mb-14">
          <h2
            class="mb-5 text-2xl font-semibold
                   text-neutral-900 dark:text-white"
          >
            Results
          </h2>

          <ul
            class="space-y-3 text-neutral-600 dark:text-neutral-400"
          >
            {project.results.map((result) => (
              <li class="flex gap-3">
                <span>✓</span>
                <span>{result}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- LINKS -->
    {
      (project.github || project.demo) && (
        <section
          class="flex flex-wrap gap-3 pt-8 border-t
                 border-neutral-200 dark:border-neutral-800"
        >
          {project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 text-sm font-medium border rounded-lg
                     border-neutral-300
                     hover:bg-neutral-100
                     dark:border-neutral-700
                     dark:hover:bg-neutral-900"
            >
              Live Demo ↗
            </a>
          )}

          {project.github && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 text-sm font-medium border rounded-lg
                     border-neutral-300
                     hover:bg-neutral-100
                     dark:border-neutral-700
                     dark:hover:bg-neutral-900"
            >
              GitHub ↗
            </a>
          )}
        </section>
      )
    }
  </article>
</Layout>